/* =====================================================================================
   NexUI Designer — visual theme
   Palette: cool near-black neutrals + violet brand accent + teal selection accent.
   Spacing follows the 8pt/4pt scale (see NexUIProjectAssetCreator's space.* theme tokens).
   Keep DesignerColors.cs (IMGUI mirror for the Advanced tool windows) in sync by eye.
   ===================================================================================== */

.nexui-designer-root {
    --nexui-bg-window: #111318;
    --nexui-bg-panel: #171a20;
    --nexui-bg-raised: #1d2129;
    --nexui-bg-input: #222630;
    --nexui-bg-hover: #262b35;
    --nexui-bg-selected: #303847;
    --nexui-border: #2a303b;
    --nexui-border-strong: #394150;
    --nexui-text-primary: #e6eaf0;
    --nexui-text-secondary: #9aa3b2;
    --nexui-text-disabled: #5f6877;
    --nexui-accent: #7c6cf2;
    --nexui-selection: #5aa9ff;
    --nexui-guide: #e26be5;
    --nexui-success: #4cc38a;
    --nexui-warning: #e5b454;
    --nexui-error: #e36a6a;
    background-color: #121317;
    color: #d7dbe2;
    min-height: 0;
}

/* ---------------------------------------------------------------------------- rebuild shell */

.nexui-shell {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--nexui-bg-window);
}

.nexui-global-toolbar {
    height: 38px;
    min-height: 38px;
    max-height: 38px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
    background-color: var(--nexui-bg-panel);
}

.nexui-global-brand {
    width: 124px;
    min-width: 124px;
    color: var(--nexui-text-primary);
    -unity-font-style: bold;
    font-size: 13px;
}

.nexui-global-screen {
    width: 280px;
    margin-right: 8px;
}

.nexui-backend-badge,
.nexui-drawer-badge {
    min-width: 74px;
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 4px;
    background-color: var(--nexui-bg-input);
    color: var(--nexui-text-secondary);
    -unity-text-align: middle-center;
    font-size: 10px;
}

.nexui-icon-text-button {
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--nexui-border);
    background-color: var(--nexui-bg-raised);
    color: var(--nexui-text-primary);
}

.nexui-body-and-drawer {
    flex-grow: 1;
    min-height: 0;
}

.nexui-rebuild-body {
    flex-grow: 1;
    min-height: 0;
}

.nexui-canvas-column {
    flex-grow: 1;
    min-width: 280px;
    min-height: 0;
    background-color: #0d0f13;
}

.nexui-canvas-toolbar {
    height: auto;
    min-height: 36px;
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 1px;
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
    background-color: #14171d;
}

.nexui-canvas-toolbar > .nexui-tool-button,
.nexui-canvas-toolbar > .unity-base-field,
.nexui-canvas-toolbar > .nexui-toolbar-button,
.nexui-canvas-toolbar > .nexui-toolbar-divider,
.nexui-canvas-toolbar > .nexui-zoom-readout {
    flex-shrink: 0;
    margin-bottom: 3px;
}

.nexui-canvas-toolbar > .nexui-toolbar-divider {
    height: 20px;
}

.nexui-tool-button {
    height: 26px;
    min-width: 54px;
    margin-right: 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    color: var(--nexui-text-secondary);
    font-size: 10px;
}

.nexui-tool-button:hover,
.nexui-tool-button.is-active {
    border-color: var(--nexui-border-strong);
    background-color: var(--nexui-bg-hover);
    color: var(--nexui-text-primary);
}

.nexui-canvas-field {
    width: 176px;
    margin-left: 4px;
    margin-right: 6px;
}

.nexui-mini-popup {
    width: 112px;
    margin-right: 6px;
}

.nexui-grid-size-field {
    width: 78px;
    margin-left: 4px;
    margin-right: 6px;
}

.nexui-zoom-readout {
    width: 48px;
    color: var(--nexui-text-primary);
    -unity-text-align: middle-center;
    font-size: 10px;
}

.nexui-left-sidebar,
.nexui-right-inspector {
    background-color: var(--nexui-bg-panel);
    min-height: 0;
}

.nexui-left-sidebar {
    min-width: 220px;
}

.nexui-right-inspector {
    min-width: 280px;
    border-left-width: 1px;
    border-left-color: var(--nexui-border);
}

.nexui-tabbar {
    height: 32px;
    min-height: 32px;
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
}

.nexui-tab {
    height: 26px;
    flex-grow: 1;
    margin-right: 4px;
    border-radius: 4px;
    border-width: 0;
    background-color: transparent;
    color: var(--nexui-text-secondary);
    font-size: 10px;
}

.nexui-tab:hover,
.nexui-tab.is-active {
    background-color: var(--nexui-bg-selected);
    color: var(--nexui-text-primary);
}

.nexui-metadata-row {
    height: 34px;
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
}

.nexui-metadata-row ObjectField {
    flex-grow: 1;
}

.nexui-square-button {
    width: 26px;
    height: 24px;
    margin-left: 6px;
    border-radius: 4px;
    background-color: var(--nexui-bg-raised);
}

.nexui-sidebar-host,
.nexui-sidebar-scroll,
.nexui-inspector-host {
    flex-grow: 1;
    min-height: 0;
}

.nexui-components-panel,
.nexui-assets-panel {
    flex-grow: 1;
    min-height: 0;
    padding: 8px;
}

.nexui-component-library-header {
    margin-bottom: 7px;
    padding: 9px 10px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(84, 151, 255, 0.24);
    background-color: rgba(29, 42, 65, 0.88);
}

.nexui-component-library-title {
    color: rgba(236, 244, 255, 0.98);
    font-size: 13px;
    -unity-font-style: bold;
}

.nexui-component-library-summary {
    margin-top: 2px;
    color: rgba(184, 202, 228, 0.82);
    font-size: 9px;
}

.nexui-component-library-search {
    margin-bottom: 5px;
}

.nexui-component-library-actions {
    margin-bottom: 7px;
    flex-direction: row;
    align-items: flex-end;
}

.nexui-component-library-actions > .nexui-palette-family {
    flex-grow: 1;
    min-width: 90px;
    margin-right: 4px;
}

.nexui-component-library-action {
    min-width: 30px;
    height: 20px;
    margin-left: 2px;
    padding-left: 5px;
    padding-right: 5px;
    border-radius: 5px;
    color: rgba(225, 236, 252, 0.96);
    background-color: rgba(84, 151, 255, 0.16);
}

.nexui-component-library-action:hover {
    background-color: rgba(84, 151, 255, 0.34);
}

.nexui-sidebar-foldout {
    margin-bottom: 8px;
}

.nexui-component-family-folder {
    margin-bottom: 10px;
    padding: 5px;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgba(255, 255, 255, 0.09);
    background-color: rgba(255, 255, 255, 0.025);
}

.nexui-component-family-folder.family-nexui {
    border-left-width: 3px;
    border-left-color: rgba(84, 151, 255, 0.70);
}

.nexui-component-family-folder.family-ugui {
    border-left-width: 3px;
    border-left-color: rgba(122, 196, 125, 0.70);
}

.nexui-component-family-folder.family-uitk {
    border-left-width: 3px;
    border-left-color: rgba(190, 128, 255, 0.70);
}

.nexui-component-family-folder.family-custom {
    border-left-width: 3px;
    border-left-color: rgba(255, 183, 77, 0.78);
    background-color: rgba(255, 183, 77, 0.035);
}

.nexui-component-category-folder {
    margin-left: 7px;
    margin-bottom: 5px;
}

.nexui-component-builtin-library {
    padding: 4px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(76, 214, 190, 0.28);
    background-color: rgba(76, 214, 190, 0.035);
}

.nexui-component-custom-folder {
    padding-left: 3px;
    border-left-width: 1px;
    border-left-color: rgba(255, 183, 77, 0.22);
}

.nexui-component-builtin-folder {
    padding-left: 3px;
    border-left-width: 1px;
    border-left-color: rgba(76, 214, 190, 0.20);
}

.nexui-component-library-empty {
    margin: 8px;
    padding: 9px;
    border-radius: 5px;
    color: rgba(205, 213, 225, 0.74);
    background-color: rgba(0, 0, 0, 0.13);
    white-space: normal;
}

.nexui-component-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.nexui-component-card {
    width: 48%;
    height: 78px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 4px;
    flex-direction: column;
    align-items: stretch;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    background-color: var(--nexui-bg-raised);
    color: var(--nexui-text-primary);
    font-size: 10px;
}

.nexui-component-card:hover {
    background-color: var(--nexui-bg-hover);
    border-color: rgba(84, 151, 255, 0.55);
}

.nexui-component-custom-card {
    border-color: rgba(255, 183, 77, 0.22);
}

.nexui-component-custom-card:hover {
    border-color: rgba(255, 183, 77, 0.70);
}

.nexui-component-builtin-card {
    border-color: rgba(76, 214, 190, 0.20);
}

.nexui-component-builtin-card:hover {
    border-color: rgba(76, 214, 190, 0.72);
    background-color: rgba(76, 214, 190, 0.07);
}

.nexui-component-custom-thumbnail {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.nexui-component-card-preview {
    height: 48px;
    min-height: 48px;
    padding: 4px;
    justify-content: center;
    align-items: stretch;
    overflow: hidden;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.18);
}

.nexui-component-preview-surface {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    justify-content: center;
    align-items: stretch;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.nexui-component-composite-preview {
    position: relative;
    justify-content: flex-start;
    align-items: flex-start;
}

.nexui-component-composite-part {
    position: absolute;
    overflow: hidden;
    justify-content: center;
    align-items: stretch;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.nexui-component-composite-text {
    flex-grow: 1;
    padding-left: 2px;
    padding-right: 2px;
    font-size: 7px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-component-preview-fallback {
    flex-grow: 1;
    padding-left: 4px;
    padding-right: 4px;
    color: rgba(255, 255, 255, 0.90);
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.nexui-component-card-caption {
    height: 20px;
    min-height: 20px;
    margin-top: 3px;
    flex-direction: row;
    align-items: center;
}

.nexui-component-card-title {
    flex-grow: 1;
    min-width: 0;
    color: var(--nexui-text-primary);
    font-size: 10px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-component-family-badge {
    height: 15px;
    min-width: 31px;
    margin-left: 3px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 7px;
    color: rgba(255, 255, 255, 0.92);
    font-size: 8px;
    -unity-text-align: middle-center;
}

.family-nexui.nexui-component-family-badge {
    background-color: rgba(80, 116, 213, 0.85);
}

.family-ugui.nexui-component-family-badge {
    background-color: rgba(71, 142, 103, 0.88);
}

.family-uitk.nexui-component-family-badge {
    background-color: rgba(154, 98, 191, 0.88);
}

.family-custom.nexui-component-family-badge {
    color: rgb(255, 204, 128);
    background-color: rgba(255, 183, 77, 0.17);
}

.family-builtin.nexui-component-family-badge {
    color: rgb(166, 245, 230);
    background-color: rgba(76, 214, 190, 0.17);
}

.nexui-component-details {
    height: 142px;
    min-height: 142px;
    margin-top: 6px;
    margin-bottom: 6px;
    padding: 7px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.17);
}

.nexui-component-details-body {
    height: 86px;
    min-height: 86px;
    flex-direction: row;
}

.nexui-component-detail-preview {
    width: 96px;
    min-width: 96px;
    height: 80px;
    padding: 7px;
    justify-content: center;
    align-items: stretch;
    overflow: hidden;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.22);
}

.nexui-component-details-copy {
    flex-grow: 1;
    min-width: 0;
    margin-left: 8px;
}

.nexui-component-details-title {
    color: var(--nexui-text-primary);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-component-details-type {
    margin-top: 1px;
    color: var(--nexui-text-secondary);
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-component-details-description {
    margin-top: 4px;
    max-height: 43px;
    color: var(--nexui-text-secondary);
    font-size: 9px;
    white-space: normal;
    overflow: hidden;
}

.nexui-component-support-row {
    height: 20px;
    min-height: 20px;
    margin-top: 3px;
    flex-direction: row;
    align-items: center;
}

.nexui-component-support-badge {
    height: 17px;
    margin-right: 4px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.92);
    font-size: 8px;
    -unity-text-align: middle-center;
}

.nexui-component-support-badge.support-full {
    background-color: rgba(52, 139, 87, 0.85);
}

.nexui-component-support-badge.support-partial {
    background-color: rgba(179, 126, 43, 0.88);
}

.nexui-component-support-badge.support-previewonly {
    background-color: rgba(70, 112, 180, 0.88);
}

.nexui-component-support-badge.support-unsupported {
    background-color: rgba(150, 66, 66, 0.88);
}

.nexui-component-details-capabilities {
    height: 17px;
    color: var(--nexui-text-secondary);
    font-size: 8px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-layers-panel {
    flex-grow: 1;
    min-height: 0;
    padding: 8px;
}

.nexui-layers-list {
    flex-grow: 1;
    min-height: 0;
    margin-top: 6px;
}

.nexui-layer-row {
    height: 26px;
    min-height: 26px;
    flex-direction: row;
    align-items: center;
    border-radius: 4px;
    margin-bottom: 2px;
}

.nexui-layer-row:hover {
    background-color: var(--nexui-bg-hover);
}

.nexui-layer-row.is-selected {
    background-color: var(--nexui-bg-selected);
}

.nexui-layer-row.is-key-object {
    border-left-width: 2px;
    border-left-color: var(--nexui-guide);
}

.nexui-layer-row.is-dragging {
    border-color: var(--nexui-selection);
    border-width: 1px;
}

.nexui-layer-icon-button {
    width: 22px;
    height: 22px;
    margin-right: 2px;
    padding-left: 0;
    padding-right: 0;
    border-radius: 4px;
    border-width: 0;
    background-color: transparent;
    color: var(--nexui-text-secondary);
    font-size: 9px;
}

.nexui-layer-icon-button:hover {
    background-color: var(--nexui-bg-raised);
    color: var(--nexui-text-primary);
}

.nexui-layer-name {
    flex-grow: 1;
    min-width: 40px;
    height: 22px;
    margin-right: 4px;
}

.nexui-asset-filters {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 10px;
}

.nexui-filter-chip {
    height: 24px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-radius: 4px;
    background-color: var(--nexui-bg-raised);
    color: var(--nexui-text-secondary);
}

.nexui-inspector-title {
    height: 32px;
    padding-left: 10px;
    padding-top: 8px;
    color: var(--nexui-text-primary);
    -unity-font-style: bold;
    font-size: 12px;
}

.nexui-bottom-drawer {
    min-height: 36px;
    background-color: var(--nexui-bg-panel);
    border-top-width: 1px;
    border-top-color: var(--nexui-border);
}

.nexui-drawer-resize {
    height: 4px;
    min-height: 4px;
    background-color: transparent;
}

.nexui-drawer-resize:hover {
    background-color: var(--nexui-accent);
}

.nexui-drawer-bar {
    height: 32px;
    min-height: 32px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
}

.nexui-drawer-bar .nexui-tabbar {
    width: 360px;
    border-bottom-width: 0;
    padding-left: 0;
}

.nexui-drawer-content {
    flex-grow: 1;
    min-height: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
}

.nexui-drawer-content > .nexui-panel {
    flex-grow: 1;
    margin-bottom: 0;
}

.nexui-inspector-host .nexui-bottom-card {
    height: auto;
    min-height: 96px;
    max-height: none;
    margin-right: 0;
    margin-bottom: 8px;
}

.nexui-inspector-host .nexui-bottom-card #PanelSubtitle {
    display: flex;
}

.nexui-drawer-placeholder {
    flex-grow: 1;
    padding: 12px;
    background-color: var(--nexui-bg-raised);
}

.nexui-command-palette-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    background-color: rgba(2, 3, 5, 0.42);
}

.nexui-command-palette {
    width: 520px;
    max-width: 520px;
    max-height: 520px;
    margin-top: 72px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--nexui-border-strong);
    background-color: #151820;
    padding: 10px;
}

.nexui-command-search {
    height: 32px;
    margin-bottom: 8px;
}

.nexui-command-results {
    max-height: 440px;
}

.nexui-command-row {
    height: 28px;
    margin-bottom: 3px;
    border-radius: 4px;
    border-width: 0;
    background-color: transparent;
    color: var(--nexui-text-primary);
    -unity-text-align: middle-left;
}

.nexui-command-row:hover {
    background-color: var(--nexui-bg-hover);
}

/* ---------------------------------------------------------------------------- utilities hub */

.nexui-utilities-root {
    padding: 0;
    background-color: var(--nexui-bg-window);
}

.nexui-utilities-header {
    padding: 18px 20px 14px 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
    background-color: var(--nexui-bg-panel);
}

.nexui-utilities-title {
    color: var(--nexui-text-primary);
    font-size: 20px;
    -unity-font-style: bold;
}

.nexui-utilities-subtitle,
.nexui-utilities-section-subtitle {
    margin-top: 3px;
    color: var(--nexui-text-secondary);
    font-size: 11px;
}

.nexui-utilities-search {
    height: 32px;
    margin: 14px 20px 6px 20px;
}

.nexui-utilities-content {
    flex-grow: 1;
    padding: 0 20px 20px 20px;
}

.nexui-utilities-section {
    margin-top: 14px;
    margin-bottom: 8px;
}

.nexui-utilities-section-title {
    color: var(--nexui-text-primary);
    font-size: 13px;
    -unity-font-style: bold;
}

.nexui-utilities-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.nexui-utility-card {
    width: 48.5%;
    min-height: 68px;
    margin-right: 1.5%;
    margin-bottom: 8px;
    padding: 10px 12px;
    align-items: flex-start;
    border-width: 1px;
    border-color: var(--nexui-border);
    border-radius: 7px;
    background-color: var(--nexui-bg-raised);
}

.nexui-utility-card:hover {
    border-color: var(--nexui-accent);
    background-color: var(--nexui-bg-hover);
}

.nexui-utility-card-title {
    color: var(--nexui-text-primary);
    font-size: 11px;
    -unity-font-style: bold;
}

.nexui-utility-card-description {
    margin-top: 4px;
    color: var(--nexui-text-secondary);
    font-size: 10px;
    white-space: normal;
}

.nexui-utilities-empty {
    margin-top: 28px;
    color: var(--nexui-text-secondary);
    -unity-text-align: middle-center;
}

.nexui-designer-root Label,
.nexui-designer-root Button,
.nexui-designer-root ToolbarButton,
.nexui-designer-root TextField,
.nexui-designer-root ObjectField,
.nexui-designer-root PopupField {
    color: #d7dbe2;
}

.nexui-designer-root TextElement {
    color: #d7dbe2;
}

.nexui-designer-root .unity-label,
.nexui-designer-root .unity-button__text,
.nexui-designer-root .unity-text-element,
.nexui-designer-root .unity-base-field__label,
.nexui-designer-root .unity-base-field__input {
    color: #d7dbe2;
}

/* ---------------------------------------------------------------------------- toolbar */

.nexui-toolbar {
    /* No fixed height: the toolbar now has 3 rows (top/bottom/selection) - a hardcoded height
       let the selection row (Align/Distribute/Layer) spill past the toolbar's box and overlap
       the panels below it. flex-shrink: 0 keeps it from being squeezed if the window is short. */
    flex-direction: column;
    flex-shrink: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 6px;
    border-bottom-width: 2px;
    border-bottom-color: #6d5efc;
    background-color: #17181d;
}

.nexui-toolbar-row {
    height: 28px;
    flex-direction: row;
    align-items: center;
}

.nexui-toolbar-row-secondary {
    margin-top: 3px;
}

.nexui-toolbar-brand {
    width: 72px;
    min-width: 72px;
    margin-right: 8px;
}

#BrandTitle {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f5f6f8;
    letter-spacing: 0.5px;
}

#BrandSubtitle {
    font-size: 9px;
    color: #a78bfa;
    margin-top: -2px;
}

.nexui-screen-field {
    width: 210px;
    margin-right: 6px;
}

.nexui-metadata-field {
    width: 230px;
    margin-right: 6px;
}

.nexui-resolution-field {
    width: 124px;
    margin-right: 6px;
}

.nexui-compact-popup {
    width: 104px;
    margin-right: 6px;
}

.nexui-compact-field {
    flex-grow: 1;
    margin-right: 6px;
}

.nexui-toolbar-toggle {
    margin-left: 4px;
    margin-right: 4px;
}

.nexui-toolbar-status {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 999px;
    font-size: 10px;
    -unity-font-style: bold;
    min-width: 72px;
    max-width: 160px;
    -unity-text-align: middle-center;
}

.nexui-toolbar-status.is-muted {
    background-color: #23262c;
    color: #9aa1ab;
}

.nexui-toolbar-status.is-ok {
    background-color: #0f2b21;
    color: #4ade80;
}

.nexui-toolbar-status.is-warning {
    background-color: #2e2410;
    color: #fbbf24;
}

.nexui-toolbar-divider {
    width: 1px;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 2px;
    margin-bottom: 2px;
    background-color: #2a2e35;
}

.nexui-toolbar-group-label {
    font-size: 9px;
    color: #6a707a;
    -unity-text-align: middle-left;
    margin-right: 4px;
}

.nexui-toolbar-button {
    height: 22px;
    margin-left: 3px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 6px;
    font-size: 10px;
}

.nexui-toolbar .unity-base-field {
    height: 22px;
    font-size: 10px;
}

.nexui-toolbar .unity-base-field__label {
    min-width: 44px;
    width: 44px;
    font-size: 10px;
    color: #9aa1ab;
}

.nexui-toolbar .unity-base-field__input {
    min-width: 42px;
}

/* Standalone graph/timeline windows. These must not use .nexui-toolbar: that class is a
   column layout owned by the multi-row main Designer toolbar. */
.nexui-tool-window-root {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--nexui-bg-window);
}

.nexui-tool-window-toolbar {
    height: auto;
    min-height: 38px;
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 6px 8px;
    border-bottom-width: 2px;
    border-bottom-color: var(--nexui-accent);
    background-color: var(--nexui-bg-panel);
}

.nexui-tool-window-toolbar > .unity-base-field,
.nexui-tool-window-toolbar > .nexui-inline-row,
.nexui-tool-window-toolbar > .nexui-toolbar-button {
    height: 24px;
    margin-right: 6px;
    margin-bottom: 3px;
}

.nexui-tool-window-toolbar > .nexui-metadata-field {
    width: 280px;
    min-width: 220px;
}

.nexui-tool-window-toolbar .unity-base-field__label {
    min-width: 54px;
    width: auto;
    color: var(--nexui-text-secondary);
    font-size: 10px;
}

.nexui-tool-window-time-row {
    height: 34px;
    min-height: 34px;
    flex-shrink: 0;
    padding-left: 10px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
    background-color: #14171d;
}

.nexui-tool-window-root > .nexui-status-row {
    min-height: 30px;
    flex-shrink: 0;
    padding-right: 8px;
}

.nexui-tool-window-root .nexui-toolbar-status {
    max-width: none;
}

.nexui-graph-panel,
.nexui-graph-surface {
    flex-grow: 1;
    min-height: 220px;
}

.nexui-graph-surface {
    border-top-width: 1px;
    border-top-color: var(--nexui-border);
    background-color: #0d0f13;
}

.nexui-graph-node {
    min-width: 240px;
    border-width: 1px;
    border-color: var(--nexui-border-strong);
    border-radius: 7px;
}

.nexui-graph-node:hover,
.nexui-graph-node.selected {
    border-color: var(--nexui-selection);
}

.nexui-graph-node .unity-base-field {
    margin-top: 3px;
    margin-bottom: 3px;
}

.nexui-graph-node .unity-base-field__label {
    min-width: 72px;
    color: var(--nexui-text-secondary);
}

/* ---------------------------------------------------------------------------- buttons */

.nexui-button-primary {
    background-color: #6d5efc;
    color: #ffffff;
    border-width: 0;
    border-radius: 6px;
}

.nexui-button-primary:hover {
    background-color: #7c6dff;
}

.nexui-button-primary:active {
    background-color: #5a4de0;
}

.nexui-button-primary TextElement,
.nexui-button-primary .unity-button__text {
    color: #ffffff;
}

.nexui-button-secondary {
    background-color: #262a31;
    color: #d7dbe2;
    border-width: 1px;
    border-color: #33383f;
    border-radius: 6px;
}

.nexui-button-secondary:hover {
    background-color: #2e333b;
    border-color: #6d5efc;
}

.nexui-button-secondary:active {
    background-color: #20242a;
}

.nexui-button-secondary TextElement,
.nexui-button-secondary .unity-button__text {
    color: #d7dbe2;
}

/* ---------------------------------------------------------------------------- layout shell */

.nexui-designer-body {
    padding: 8px;
    min-height: 0;
}

.nexui-side-panel {
    background-color: #1a1d22;
    border-radius: 10px;
    border-width: 1px;
    border-color: #2a2e35;
    padding: 8px;
    min-height: 0;
}

/* Widths/heights below are floors only - the panels sit inside TwoPaneSplitView panes now
   (see NexUIDesignerWindow.Rebuild), so the user drags the actual size; these just stop a
   panel from being dragged down to something unusable. */
.nexui-left-panel {
    margin-right: 4px;
    min-width: 120px;
}

.nexui-right-panel {
    margin-left: 4px;
    min-width: 180px;
}

.nexui-center-panel {
    min-width: 200px;
    min-height: 0;
}

.nexui-bottom-panel {
    min-height: 40px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    overflow: hidden;
}

/* TwoPaneSplitView drag handles, recolored to match the theme (default Unity styling is a
   thin near-invisible line otherwise). */
.unity-two-pane-split-view__dragline-anchor {
    background-color: transparent;
}

.unity-two-pane-split-view__dragline {
    background-color: #2a2e35;
}

.unity-two-pane-split-view__dragline-anchor:hover .unity-two-pane-split-view__dragline {
    background-color: #6d5efc;
}

.nexui-panel {
    background-color: #1a1d22;
    border-radius: 10px;
    border-width: 1px;
    border-color: #2a2e35;
    padding: 8px;
    margin-bottom: 8px;
}

#PanelTitle {
    font-size: 12px;
    -unity-font-style: bold;
    color: #f5f6f8;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: #262a31;
}

#PanelSubtitle {
    font-size: 11px;
    color: #9aa1ab;
    margin-bottom: 8px;
}

#EmptyStateText {
    color: #6a707a;
    font-size: 11px;
}

/* ---------------------------------------------------------------------------- lists / hierarchy */

.nexui-list {
    background-color: #131418;
    border-radius: 6px;
    border-width: 1px;
    border-color: #262a31;
    min-height: 70px;
}

.nexui-list .unity-collection-view__item,
.nexui-list .unity-list-view__item {
    border-radius: 4px;
}

.nexui-list .unity-collection-view__item:hover,
.nexui-list .unity-list-view__item:hover {
    background-color: #1e222a;
}

.nexui-list .unity-collection-view__item--selected,
.nexui-list .unity-list-view__item--selected {
    background-color: #362a66;
}

.nexui-hierarchy-row {
    height: 22px;
    color: #dfe3ea;
    -unity-text-align: middle-left;
}

.nexui-hierarchy-panel {
    flex-grow: 1;
    min-height: 0;
}

.nexui-empty-note {
    white-space: normal;
    color: #767c87;
    font-size: 11px;
    margin-bottom: 8px;
}

/* ---------------------------------------------------------------------------- palette */

.nexui-palette {
    flex-shrink: 0;
}

.nexui-palette-grid,
.nexui-align-grid {
    flex-direction: column;
    margin-bottom: 8px;
}

.nexui-palette-category {
    margin-bottom: 6px;
}

.nexui-palette-category > .unity-fold-out__toggle .unity-toggle__input {
    margin-right: 4px;
}

.nexui-palette-category Toggle {
    -unity-font-style: bold;
    font-size: 10px;
    color: #9aa1ab;
}

.nexui-palette-category > .unity-fold-out__content {
    margin-left: 2px;
    padding-left: 6px;
    border-left-width: 1px;
    border-left-color: #262a31;
}

.nexui-palette-category .nexui-palette-button {
    margin-bottom: 3px;
    margin-right: 0;
}

/* Vertical Align/Distribute/Layer strip, docked beside the Palette (see
   NexUIDesignerAlignPanel) instead of a third toolbar row. */
.nexui-align-panel {
    width: 60px;
    min-width: 60px;
    flex-shrink: 0;
    margin-left: 6px;
}

.nexui-align-panel-button {
    height: 22px;
    margin-bottom: 4px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2a2e35;
    background-color: #1e2128;
    color: #d7dbe2;
    font-size: 10px;
}

.nexui-align-panel-button:hover {
    background-color: #262a31;
    border-color: #6d5efc;
}

.nexui-align-panel-button:active {
    background-color: #362a66;
}

.nexui-align-panel-divider {
    height: 1px;
    margin-top: 4px;
    margin-bottom: 6px;
    background-color: #262a31;
}

.nexui-palette-row {
    flex-direction: row;
    height: 24px;
    margin-bottom: 4px;
}

.nexui-palette-button,
.nexui-align-button {
    flex-grow: 1;
    height: 22px;
    margin-right: 4px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2a2e35;
    background-color: #1e2128;
    color: #d7dbe2;
    font-size: 10px;
}

.nexui-palette-button:hover,
.nexui-align-button:hover {
    background-color: #262a31;
    border-color: #6d5efc;
}

.nexui-palette-button:active,
.nexui-align-button:active {
    background-color: #362a66;
}

.nexui-align-button {
    font-size: 10px;
}

/* ---------------------------------------------------------------------------- inspector */

.nexui-inspector {
    flex-grow: 1;
    min-height: 0;
}

.nexui-inspector .unity-base-field {
    flex-direction: column;
    margin-bottom: 4px;
}

.nexui-inspector .unity-base-field__label {
    width: auto;
    min-width: 0;
    font-size: 10px;
    color: #9aa1ab;
    margin-bottom: 1px;
}

.nexui-inspector .unity-base-field__input {
    min-width: 0;
}

.nexui-inspector Button:hover {
    background-color: #2e333b;
}

.nexui-inspector-section {
    background-color: #15171b;
    border-radius: 8px;
    border-width: 1px;
    border-color: #262a31;
    padding: 8px;
    margin-bottom: 8px;
}

.nexui-unified-inspector {
    min-width: 320px;
}

.nexui-inspector-identity {
    padding: 8px 10px 7px 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
}

.nexui-inspector-identity-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
}

.nexui-inspector-identity-active {
    margin-right: 4px;
    margin-bottom: 0;
}

.nexui-inspector-identity-name {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
}

.nexui-inspector-identity-name > .unity-text-field__input {
    min-height: 22px;
    border-radius: 4px;
    color: var(--nexui-text-primary);
    font-size: 12px;
    -unity-font-style: bold;
}

.nexui-inspector-selection-title {
    flex-grow: 1;
    color: var(--nexui-text-primary);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.nexui-inspector-selection-subtitle {
    margin-top: 3px;
    margin-left: 2px;
    color: var(--nexui-text-secondary);
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
}

.nexui-inspector-overflow {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin-left: 4px;
    padding: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: transparent;
    color: var(--nexui-text-secondary);
    font-size: 13px;
}

.nexui-inspector-overflow:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--nexui-text-primary);
}

.nexui-inspector-search {
    margin: 6px 8px;
    min-width: 110px;
}

.nexui-inspector-host {
    padding: 7px 7px 10px 7px;
}

.nexui-inspector-block {
    margin-bottom: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
    background-color: #1c1f25;
}

.nexui-inspector-block > .nexui-inspector-block__menu {
    position: absolute;
    right: 2px;
    top: 2px;
    width: 20px;
    min-width: 20px;
    height: 20px;
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: transparent;
    color: var(--nexui-text-secondary);
    font-size: 12px;
}

.nexui-inspector-block > .nexui-inspector-block__menu:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--nexui-text-primary);
}

.nexui-inspector-block__foldout > .unity-foldout__toggle {
    min-height: 24px;
    margin: 0;
    padding-left: 4px;
    padding-right: 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.25);
    background-color: rgba(255, 255, 255, 0.035);
    color: var(--nexui-text-primary);
    -unity-font-style: bold;
}

.nexui-inspector-block__foldout > .unity-foldout__content {
    margin-left: 0;
    padding: 6px 8px 8px 8px;
}

.nexui-inspector-block.exposure-diagnostic > .nexui-inspector-block__foldout > .unity-foldout__toggle {
    color: var(--nexui-text-secondary);
}

.nexui-inspector-block__content {
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: transparent;
}

/* The component stack is drawn as bare cards, the way Unity draws components: no outer
   container, so nothing is foldered twice. */
.nexui-inspector-component-stack {
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: transparent;
}

.nexui-inspector-add-component {
    height: 26px;
    margin: 8px 24px 4px 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    background-color: #2b3038;
    color: var(--nexui-text-primary);
    font-size: 11px;
}

.nexui-inspector-add-component:hover {
    background-color: #353b45;
}

.nexui-inspector-reveal-pro {
    height: 28px;
    margin: 2px 0 8px 0;
    border-width: 1px;
    border-color: var(--nexui-accent);
    border-radius: 5px;
    background-color: transparent;
    color: #b8a9ff;
}

.nexui-inspector-empty {
    min-height: 118px;
    margin-top: 3px;
    padding: 16px 10px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(255, 255, 255, 0.07);
    background-color: rgba(0, 0, 0, 0.12);
}

.nexui-inspector-empty-icon {
    width: 34px;
    height: 34px;
    margin-bottom: 7px;
    border-radius: 17px;
    color: rgba(178, 198, 226, 0.88);
    background-color: rgba(91, 111, 145, 0.18);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.nexui-inspector-empty-title {
    color: var(--nexui-text-secondary);
    font-size: 9px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.nexui-inspector-empty-action {
    min-width: 104px;
    height: 26px;
    margin-top: 9px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(73, 145, 255, 0.40);
    color: rgb(211, 229, 255);
    background-color: rgba(73, 145, 255, 0.12);
}

#SectionTitle {
    -unity-font-style: bold;
    color: #b8a9ff;
    margin-bottom: 6px;
    font-size: 11px;
}

/* ---------------------------------------------------------------------------- validation */

.nexui-validation-panel {
    min-height: 78px;
    border-left-width: 3px;
    border-left-color: #2a2e35;
}

.nexui-validation-panel.is-valid {
    border-left-color: #22c55e;
}

.nexui-validation-panel.has-issues {
    border-left-color: #f59e0b;
}

.nexui-validation-summary {
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: #d7dbe2;
}

.nexui-validation-content {
    white-space: normal;
    color: #c3c9d3;
}

.nexui-validation-item {
    white-space: normal;
    color: #c3c9d3;
    font-size: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: #21242a;
}

/* ---------------------------------------------------------------------------- history panel */

.nexui-history-panel {
    border-left-width: 3px;
    border-left-color: #6d5efc;
    max-height: 220px;
}

.nexui-history-panel .nexui-list {
    min-height: 90px;
}

/* ---------------------------------------------------------------------------- bottom dock */

.nexui-bottom-card {
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    margin-right: 8px;
    margin-bottom: 0;
    min-width: 0;
    padding-top: 4px;
    padding-bottom: 3px;
    overflow: hidden;
}

.nexui-inline-row {
    flex-direction: row;
}

.nexui-inline-row TextField {
    flex-grow: 1;
    margin-right: 6px;
}

.nexui-bottom-text {
    color: #c3c9d3;
    white-space: nowrap;
    font-size: 10px;
    margin-left: 6px;
}

.nexui-bottom-card #PanelTitle {
    font-size: 10px;
    margin-bottom: 0;
    border-bottom-width: 0;
    padding-bottom: 0;
}

.nexui-bottom-card #PanelSubtitle {
    display: none;
}

/* ---------------------------------------------------------------------------- viewport / canvas */

.nexui-viewport {
    background-color: #0e0f12;
    border-radius: 10px;
    border-width: 1px;
    border-color: #2a2e35;
    padding: 12px;
    min-height: 0;
}

.nexui-viewport-header {
    flex-direction: row;
    align-items: center;
}

.nexui-viewport-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #f5f6f8;
}

.nexui-viewport-hint {
    font-size: 10px;
    color: #8a909b;
    margin-top: 2px;
    margin-bottom: 10px;
}

.nexui-zoom-badge {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: 999px;
    background-color: #1e2128;
    color: #b8a9ff;
    font-size: 10px;
    -unity-font-style: bold;
}

.nexui-preview-frame {
    flex-grow: 1;
    min-height: 0;
    background-color: #0a0b0d;
    border-radius: 8px;
    border-width: 1px;
    border-color: #202329;
    padding: 12px;
}

.nexui-preview-canvas {
    background-color: #1c1f26;
    border-width: 1px;
    border-color: #6d5efc;
    border-radius: 8px;
    overflow: hidden;
}

.nexui-preview-canvas.is-empty {
    border-color: #33383f;
    background-color: #16181d;
}

.nexui-grid-layer,
.nexui-motion-ghost-layer,
.nexui-element-layer,
.nexui-guide-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Attached MonoBehaviour inspector ------------------------------------------------------- */
.nexui-attached-overview {
    min-height: 52px;
    margin-bottom: 6px;
    padding: 7px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgba(73, 145, 255, 0.28);
    background-color: rgba(34, 58, 92, 0.58);
}

.nexui-attached-overview-icon {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    border-radius: 7px;
    color: rgb(178, 218, 255);
    background-color: rgba(58, 129, 221, 0.30);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.nexui-attached-overview-copy,
.nexui-attached-card-copy,
.nexui-component-picker-card-copy,
.nexui-component-picker-detail-copy {
    flex-grow: 1;
    min-width: 0;
}

.nexui-attached-overview-title {
    color: var(--nexui-text-primary);
    font-size: 11px;
    -unity-font-style: bold;
}

.nexui-attached-overview-target {
    margin-top: 2px;
    color: var(--nexui-text-secondary);
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-attached-backend-badge {
    min-width: 38px;
    height: 18px;
    margin-left: 6px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 9px;
    color: rgb(157, 238, 190);
    background-color: rgba(47, 151, 91, 0.22);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.nexui-attached-help {
    margin-bottom: 7px;
    padding: 6px 7px;
    border-left-width: 2px;
    border-left-color: rgba(73, 145, 255, 0.60);
    border-radius: 4px;
    color: rgba(190, 204, 224, 0.88);
    background-color: rgba(73, 145, 255, 0.07);
    font-size: 9px;
    white-space: normal;
}

.nexui-attached-list {
    margin-bottom: 5px;
}

.nexui-attached-card {
    position: relative;
    min-height: 94px;
    margin-bottom: 5px;
    padding: 7px 27px 7px 7px;
    flex-direction: row;
    align-items: flex-start;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgba(255, 255, 255, 0.09);
    background-color: rgba(255, 255, 255, 0.025);
}

.nexui-attached-card:hover {
    border-color: rgba(73, 145, 255, 0.48);
    background-color: rgba(73, 145, 255, 0.055);
}

.nexui-attached-card.is-missing {
    border-color: rgba(239, 91, 91, 0.42);
    background-color: rgba(239, 91, 91, 0.055);
}

.nexui-attached-icon-frame {
    width: 36px;
    min-width: 36px;
    height: 36px;
    margin-right: 8px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 0.11);
    background-color: rgba(0, 0, 0, 0.18);
    -unity-background-scale-mode: scale-to-fit;
}

.nexui-attached-icon-fallback {
    flex-grow: 1;
    color: rgba(188, 216, 255, 0.94);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.nexui-attached-card-title {
    color: var(--nexui-text-primary);
    font-size: 11px;
    -unity-font-style: bold;
}

.nexui-attached-card-category {
    margin-top: 1px;
    color: rgba(131, 169, 220, 0.90);
    font-size: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-attached-card-description {
    margin-top: 4px;
    color: rgba(198, 205, 216, 0.88);
    font-size: 9px;
    white-space: normal;
}

.nexui-attached-card-meta {
    margin-top: 5px;
    flex-direction: row;
    flex-wrap: wrap;
}

.nexui-attached-badge {
    height: 15px;
    margin-right: 3px;
    margin-bottom: 2px;
    padding-left: 5px;
    padding-right: 5px;
    border-radius: 7px;
    color: rgba(198, 221, 255, 0.95);
    background-color: rgba(73, 145, 255, 0.15);
    font-size: 7px;
    -unity-text-align: middle-center;
}

.nexui-attached-badge.is-single {
    color: rgb(255, 213, 142);
    background-color: rgba(255, 173, 51, 0.14);
}

.nexui-attached-badge.is-edit {
    color: rgb(207, 172, 255);
    background-color: rgba(151, 91, 230, 0.16);
}

.nexui-attached-card-requires,
.nexui-component-picker-detail-requires {
    margin-top: 4px;
    color: rgb(245, 190, 113);
    font-size: 8px;
    white-space: normal;
}

.nexui-attached-remove {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 20px;
    height: 20px;
    padding: 0;
    border-width: 0;
    border-radius: 10px;
    color: rgba(211, 218, 228, 0.78);
    background-color: rgba(255, 255, 255, 0.045);
}

.nexui-attached-remove:hover {
    color: rgb(255, 195, 195);
    background-color: rgba(222, 70, 70, 0.25);
}

.nexui-attached-empty {
    margin-bottom: 5px;
    padding: 12px 8px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 0.07);
    color: var(--nexui-text-secondary);
    background-color: rgba(0, 0, 0, 0.12);
    font-size: 9px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.nexui-attached-add {
    height: 29px;
    margin-top: 2px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(73, 145, 255, 0.48);
    color: rgb(211, 229, 255);
    background-color: rgba(73, 145, 255, 0.14);
    -unity-font-style: bold;
}

/* Add Component picker ------------------------------------------------------------------ */
.nexui-component-picker {
    padding: 10px;
    background-color: var(--nexui-bg-base);
}

.nexui-component-picker-header {
    margin-bottom: 8px;
    padding: 10px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(73, 145, 255, 0.27);
    background-color: rgba(31, 49, 76, 0.82);
}

.nexui-component-picker-title {
    color: var(--nexui-text-primary);
    font-size: 15px;
    -unity-font-style: bold;
}

.nexui-component-picker-subtitle {
    margin-top: 3px;
    color: var(--nexui-text-secondary);
    font-size: 9px;
    white-space: normal;
}

.nexui-component-picker-search {
    margin-bottom: 7px;
}

.nexui-component-picker-details {
    min-height: 96px;
    margin-bottom: 6px;
    padding: 8px;
    flex-direction: row;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgba(255, 255, 255, 0.09);
    background-color: rgba(0, 0, 0, 0.17);
}

.nexui-component-picker-detail-icon {
    width: 48px;
    min-width: 48px;
    height: 48px;
    margin-right: 9px;
    -unity-background-scale-mode: scale-to-fit;
}

.nexui-component-picker-detail-title {
    color: var(--nexui-text-primary);
    font-size: 12px;
    -unity-font-style: bold;
}

.nexui-component-picker-detail-identity {
    margin-top: 1px;
    color: rgba(126, 160, 207, 0.90);
    font-size: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-component-picker-detail-description {
    margin-top: 5px;
    color: rgba(201, 209, 220, 0.90);
    font-size: 9px;
    white-space: normal;
}

.nexui-component-picker-summary {
    margin: 2px 4px 5px 4px;
    color: var(--nexui-text-secondary);
    font-size: 9px;
}

.nexui-component-picker-results {
    min-height: 0;
}

.nexui-component-picker-group {
    margin-bottom: 5px;
}

.nexui-component-picker-card {
    min-height: 55px;
    margin: 2px 2px 3px 12px;
    padding: 6px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 0.07);
    background-color: rgba(255, 255, 255, 0.02);
}

.nexui-component-picker-card:hover {
    border-color: rgba(73, 145, 255, 0.48);
    background-color: rgba(73, 145, 255, 0.08);
}

.nexui-component-picker-icon {
    width: 32px;
    min-width: 32px;
    height: 32px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.nexui-component-picker-card-title {
    color: var(--nexui-text-primary);
    font-size: 10px;
    -unity-font-style: bold;
}

.nexui-component-picker-card-description {
    margin-top: 2px;
    color: var(--nexui-text-secondary);
    font-size: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-component-picker-source {
    min-width: 42px;
    height: 15px;
    margin-left: 5px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 7px;
    color: rgba(194, 217, 248, 0.90);
    background-color: rgba(73, 145, 255, 0.13);
    font-size: 7px;
    -unity-text-align: middle-center;
}

.nexui-component-picker-source.is-project {
    color: rgb(255, 213, 142);
    background-color: rgba(255, 173, 51, 0.14);
}

.nexui-component-picker-empty {
    flex-grow: 1;
    color: var(--nexui-text-secondary);
    -unity-text-align: middle-center;
}

.nexui-motion-start-ghost {
    border-top-color: rgba(94, 223, 188, 0.9);
    border-right-color: rgba(94, 223, 188, 0.9);
    border-bottom-color: rgba(94, 223, 188, 0.9);
    border-left-color: rgba(94, 223, 188, 0.9);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.nexui-grid-layer {
    background-color: #17191f;
}

.nexui-guide-layer {
    background-color: transparent;
}

.nexui-grid-line,
.nexui-grid-line-major {
    position: absolute;
    background-color: #24272e;
}

.nexui-grid-line-major {
    background-color: #33383f;
}

.nexui-canvas-empty-state {
    position: absolute;
    left: 32px;
    top: 32px;
    color: #8a909b;
    white-space: normal;
}

.nexui-design-element {
    border-width: 1px;
    border-color: #33383f;
    padding: 8px;
    overflow: hidden;
}

.nexui-design-element.has-preview-image {
    padding: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
}

.nexui-design-element.has-preview-image:hover {
    border-color: var(--nexui-selection);
}

/* Designer-canvas preview shape (see DesignerElementShape / StyleInspector's Shape field).
   Pill uses a fixed radius far larger than any element's half-height so the renderer clamps
   it down to a true stadium shape regardless of size; Circle uses 50% so it becomes a true
   circle on a square rect and an ellipse otherwise. */
.shape-rectangle {
    border-radius: 0;
}

.shape-rounded {
    border-radius: 8px;
}

.shape-pill {
    border-radius: 999px;
}

.shape-circle {
    border-radius: 50%;
}

/* Type-specific internal preview structure (see NexUIDesignerViewport.AddTypeSpecificPreview) -
   ProgressBar/StatBar/RadialFill/Spinner/ChoiceList/List/Grid/Skeleton get an actual mock of
   their internal parts instead of a bare tinted box. */
.nexui-preview-fill-track {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    height: 10px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 5px;
    overflow: hidden;
}

/* Vertical fill (BottomToTop/TopToBottom): a thin tall track on the right edge instead of a
   wide short one along the bottom. */
.nexui-preview-fill-track.is-vertical {
    left: auto;
    right: 8px;
    top: 22px;
    bottom: 8px;
    width: 10px;
    height: auto;
}

.nexui-preview-fill-bar {
    border-radius: 5px;
}

.nexui-preview-icon {
    position: absolute;
    width: 24px;
    height: 24px;
    left: 50%;
    top: 50%;
    margin-left: -12px;
    margin-top: -12px;
}

.nexui-preview-radial {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 22px;
    bottom: 8px;
}

.nexui-preview-choice-list {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 22px;
    bottom: 8px;
    flex-direction: column;
}

.nexui-preview-choice-row {
    flex-direction: row;
    align-items: center;
    height: 18px;
    margin-bottom: 4px;
}

.nexui-preview-choice-box {
    width: 14px;
    height: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.25);
}

.nexui-preview-choice-box.is-checked {
    background-color: #43e6c2;
    border-color: #43e6c2;
}

.nexui-preview-list {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 22px;
    bottom: 8px;
    flex-direction: column;
}

.nexui-preview-list-row {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    margin-bottom: 4px;
}

.nexui-preview-grid {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 22px;
    bottom: 8px;
    flex-direction: row;
    flex-wrap: wrap;
}

.nexui-preview-grid-cell {
    width: 30%;
    height: 45%;
    margin: 1.5%;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

.nexui-preview-skeleton {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 22px;
    bottom: 8px;
    flex-direction: column;
    justify-content: center;
}

.nexui-preview-skeleton-bar {
    height: 10px;
    margin-bottom: 6px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.25);
}

.nexui-design-element.is-selected {
    border-width: 2px;
    border-color: var(--nexui-selection);
}

.nexui-design-element.is-key-object {
    border-color: var(--nexui-guide);
}

.nexui-design-element.is-locked {
    opacity: 0.68;
}

/* C1: visible style-apply feedback - briefly highlights an element after any property change
   (see NexUIDesignerContext.ElementChanged / NexUIDesignerViewport.FlashElement). */
.nexui-element-flash {
    border-width: 2px;
    border-color: #facc15;
}

.nexui-element-name {
    -unity-font-style: bold;
    color: #f5f6f8;
    font-size: 11px;
}

.nexui-element-text {
    color: #ffffff;
    margin-top: 4px;
    white-space: normal;
}

.nexui-element-meta {
    position: absolute;
    left: 8px;
    bottom: 6px;
    color: #8a909b;
    font-size: 10px;
}

.nexui-resize-handle {
    position: absolute;
    right: 4px;
    bottom: 4px;
    width: 11px;
    height: 11px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: #43e6c2;
}

.nexui-selection-handle {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    border-width: 1px;
    border-color: #ffffff;
    background-color: var(--nexui-selection);
    display: none;
}

.nexui-design-element.is-selected .nexui-selection-handle,
.nexui-design-element.is-selected .nexui-rotation-handle {
    display: flex;
}

.handle-nw { left: -4px; top: -4px; }
.handle-n { left: 50%; top: -4px; margin-left: -4px; }
.handle-ne { right: -4px; top: -4px; }
.handle-e { right: -4px; top: 50%; margin-top: -4px; }
.handle-se { right: -4px; bottom: -4px; }
.handle-s { left: 50%; bottom: -4px; margin-left: -4px; }
.handle-sw { left: -4px; bottom: -4px; }
.handle-w { left: -4px; top: 50%; margin-top: -4px; }

.nexui-rotation-handle {
    position: absolute;
    width: 8px;
    height: 8px;
    left: 50%;
    top: -22px;
    margin-left: -4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #ffffff;
    background-color: var(--nexui-guide);
    display: none;
}

.nexui-floating-toolbar {
    position: absolute;
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 6px;
    padding-right: 4px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--nexui-border-strong);
    background-color: #151922;
}

.nexui-floating-label {
    color: var(--nexui-text-primary);
    -unity-font-style: bold;
    font-size: 10px;
    margin-right: 6px;
}

.nexui-floating-button {
    height: 22px;
    margin-right: 3px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 4px;
    border-width: 0;
    background-color: var(--nexui-bg-raised);
    color: var(--nexui-text-secondary);
    font-size: 10px;
}

.nexui-floating-button:hover {
    background-color: var(--nexui-bg-hover);
    color: var(--nexui-text-primary);
}

.nexui-canvas-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #f5f6f8;
}

.nexui-canvas-meta {
    color: #8a909b;
    margin-top: 4px;
}

.nexui-selection-rect {
    border-width: 1px;
    border-color: #43e6c2;
    background-color: rgba(67, 230, 194, 0.12);
}

.nexui-smart-guide-line {
    position: absolute;
    background-color: var(--nexui-guide);
}

.nexui-smart-guide-line.is-vertical {
    width: 1px;
    top: 0;
}

.nexui-smart-guide-line.is-horizontal {
    height: 1px;
    left: 0;
}

.nexui-distance-label {
    position: absolute;
    height: 20px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 4px;
    background-color: #23192a;
    color: var(--nexui-guide);
    -unity-font-style: bold;
    font-size: 10px;
}

/* --------------------------------------------------------------------------- pane headers */
/* One compact caption per region so the window says what each pane is without a tooltip hunt. */

.nexui-pane-header {
    flex-direction: row;
    align-items: center;
    height: 18px;
    min-height: 18px;
    padding-left: 8px;
    padding-right: 6px;
    background-color: var(--nexui-bg-window);
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
}

.nexui-pane-header-title {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--nexui-text-secondary);
}

.nexui-pane-header-detail {
    font-size: 9px;
    margin-left: 6px;
    color: var(--nexui-text-disabled);
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-pane-header-trailing {
    flex-direction: row;
    align-items: center;
}

.nexui-pane-header-button {
    height: 14px;
    min-width: 18px;
    margin: 0;
    padding-left: 4px;
    padding-right: 4px;
    border-width: 0;
    border-radius: 3px;
    background-color: transparent;
    color: var(--nexui-text-disabled);
    font-size: 10px;
}

.nexui-pane-header-button:hover {
    background-color: var(--nexui-bg-hover);
    color: var(--nexui-text-primary);
}

/* ------------------------------------------------------------------------- transform bar */

.nexui-transform-bar {
    flex-direction: row;
    align-items: center;
    height: 24px;
    min-height: 24px;
    padding-left: 6px;
    padding-right: 8px;
    background-color: var(--nexui-bg-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
}

.nexui-transform-field {
    width: 74px;
    margin-right: 4px;
    font-size: 10px;
}

.nexui-transform-field > .unity-base-field__label {
    min-width: 12px;
    width: 12px;
    color: var(--nexui-text-secondary);
    font-size: 10px;
}

.nexui-transform-field > .unity-base-field__input {
    background-color: var(--nexui-bg-input);
    border-color: var(--nexui-border);
    border-radius: 3px;
}

.nexui-transform-summary {
    font-size: 10px;
    color: var(--nexui-text-disabled);
}

/* ---------------------------------------------------------------------------- rulers & guides */

.nexui-canvas-area {
    flex-grow: 1;
    min-height: 0;
}

.nexui-ruler-row {
    flex-direction: row;
    height: 18px;
    min-height: 18px;
}

.nexui-canvas-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.nexui-ruler-corner {
    width: 18px;
    min-width: 18px;
    background-color: var(--nexui-bg-raised);
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--nexui-border);
}

.nexui-ruler-corner:hover {
    background-color: var(--nexui-bg-hover);
}

.nexui-ruler {
    background-color: var(--nexui-bg-raised);
    border-color: var(--nexui-border);
    overflow: hidden;
}

.nexui-ruler.is-horizontal-strip {
    flex-grow: 1;
    height: 18px;
    border-bottom-width: 1px;
}

.nexui-ruler.is-vertical-strip {
    width: 18px;
    min-width: 18px;
    border-right-width: 1px;
}

.nexui-ruler-ticks {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.nexui-ruler-tick {
    position: absolute;
}

.is-horizontal-strip .nexui-ruler-tick {
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--nexui-border-strong);
}

.is-vertical-strip .nexui-ruler-tick {
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--nexui-border-strong);
}

.nexui-ruler-label {
    position: absolute;
    font-size: 8px;
    color: var(--nexui-text-disabled);
}

.is-horizontal-strip .nexui-ruler-label {
    left: 3px;
    top: 2px;
}

.is-vertical-strip .nexui-ruler-label {
    left: 2px;
    top: 2px;
}

.nexui-ruler-cursor {
    position: absolute;
    background-color: var(--nexui-selection);
    opacity: 0.9;
}

.is-horizontal-strip .nexui-ruler-cursor {
    top: 0;
    bottom: 0;
    width: 1px;
}

.is-vertical-strip .nexui-ruler-cursor {
    left: 0;
    right: 0;
    height: 1px;
}

.nexui-guide-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The grab band is transparent and wide so a 1px guide can actually be picked up. */
.nexui-guide-band {
    position: absolute;
    align-items: center;
    justify-content: center;
}

.nexui-guide-band.is-vertical {
    top: 0;
    bottom: 0;
    width: 11px;
    cursor: resize-horizontal;
}

.nexui-guide-band.is-horizontal {
    left: 0;
    right: 0;
    height: 11px;
    cursor: resize-vertical;
}

.nexui-guide-line {
    position: absolute;
    background-color: var(--nexui-guide);
    opacity: 0.75;
}

.nexui-guide-line.is-vertical {
    top: 0;
    bottom: 0;
    width: 1px;
}

.nexui-guide-line.is-horizontal {
    left: 0;
    right: 0;
    height: 1px;
}

/* Hovering or dragging the band thickens the line so the grab target is obvious. */
.nexui-guide-band:hover > .nexui-guide-line,
.nexui-guide-band.is-dragging > .nexui-guide-line {
    opacity: 1;
    background-color: var(--nexui-selection);
}

.nexui-guide-band:hover > .nexui-guide-line.is-vertical,
.nexui-guide-band.is-dragging > .nexui-guide-line.is-vertical {
    width: 2px;
}

.nexui-guide-band:hover > .nexui-guide-line.is-horizontal,
.nexui-guide-band.is-dragging > .nexui-guide-line.is-horizontal {
    height: 2px;
}

.nexui-guide-line.is-preview {
    opacity: 1;
    background-color: var(--nexui-selection);
}

/* The container a drag would drop into. Deliberately loud - re-parenting changes structure, so it
   must never happen without the user having seen where it was going. */
.nexui-design-element.is-drop-target {
    border-width: 2px;
    border-color: var(--nexui-selection);
    background-color: rgba(90, 169, 255, 0.12);
}

/* Space held: the canvas is ready to pan, so say so instead of leaving the user guessing. */
.nexui-preview-canvas.is-pan-ready {
    cursor: pan;
}

/* Feedback shown while an asset is dragged over the canvas, so the drop is never a surprise. */
.nexui-drop-hint {
    position: absolute;
    height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 4px;
    background-color: var(--nexui-bg-selected);
    color: var(--nexui-text-primary);
    border-width: 1px;
    border-color: var(--nexui-accent);
    -unity-font-style: bold;
    font-size: 10px;
}

/* ---------------------------------------------------------------------------- assets panel */

.nexui-assets-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.nexui-assets-search {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 4px;
}

.nexui-assets-filter {
    width: 74px;
}

.nexui-assets-breadcrumbs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.nexui-assets-crumb {
    height: 18px;
    margin-right: 2px;
    padding-left: 5px;
    padding-right: 5px;
    border-width: 0;
    border-radius: 3px;
    background-color: transparent;
    color: var(--nexui-text-secondary);
    font-size: 10px;
}

.nexui-assets-crumb:hover {
    background-color: var(--nexui-bg-hover);
    color: var(--nexui-text-primary);
}

.nexui-assets-crumb:disabled {
    color: var(--nexui-text-primary);
    opacity: 1;
}

.nexui-assets-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 4px;
}

.nexui-assets-row:hover {
    background-color: var(--nexui-bg-hover);
}

.nexui-assets-row.is-selected {
    background-color: var(--nexui-bg-selected);
}

.nexui-assets-icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    border-radius: 3px;
    background-color: var(--nexui-bg-raised);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.nexui-assets-icon Label {
    font-size: 11px;
    color: var(--nexui-text-secondary);
}

.nexui-assets-text {
    flex-grow: 1;
    min-width: 0;
}

.nexui-assets-name {
    font-size: 11px;
    color: var(--nexui-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-assets-path {
    font-size: 9px;
    color: var(--nexui-text-disabled);
    overflow: hidden;
    text-overflow: ellipsis;
}

.nexui-assets-status {
    font-size: 9px;
    color: var(--nexui-text-disabled);
    padding-top: 4px;
}

#AssetsEmptyState {
    font-size: 10px;
    color: var(--nexui-text-disabled);
    padding-top: 10px;
    white-space: normal;
}

.nexui-rename-field {
    background-color: #0e0f12;
    border-width: 2px;
    border-color: #43e6c2;
    border-radius: 6px;
    padding: 2px 4px;
}

.nexui-multiselect-summary {
    -unity-font-style: bold;
    color: #f5f6f8;
    margin-bottom: 4px;
}

.nexui-status-row {
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: #2a2e35;
}

.nexui-timeline {
    margin-top: 6px;
}

.nexui-timeline > #Ruler,
.nexui-master-ruler {
    min-height: 22px;
    border-radius: 5px;
}

.nexui-timeline > #Ruler {
    min-height: 32px;
}

.nexui-timeline-keyframe {
    position: absolute;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border-width: 2px;
    border-color: #d8d3ff;
    border-radius: 5px;
    background-color: var(--nexui-accent);
}

.nexui-timeline-keyframe:hover {
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-color: #ffffff;
}

.nexui-keyframe-row {
    min-height: 32px;
    align-items: center;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border);
}

.nexui-keyframe-row > .unity-base-field {
    flex-shrink: 0;
    margin-right: 8px;
}

.nexui-keyframe-easing {
    min-width: 230px;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    margin-right: 8px;
}

.nexui-easing-preview {
    flex-shrink: 0;
    margin-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--nexui-border-strong);
}

.nexui-timeline-tick {
    position: absolute;
    top: 0;
    width: 1px;
    height: 8px;
    background-color: #3a3f48;
}

.nexui-timeline-tick-label {
    position: absolute;
    top: 9px;
    font-size: 9px;
    color: #8a909b;
}

.nexui-timeline-playhead {
    position: absolute;
    top: 0;
    width: 1px;
    height: 100%;
    background-color: #43e6c2;
}

.nexui-timeline-keyframe-selected {
    border-color: #6d5efc;
    background-color: #6d5efc;
}

.nexui-timeline-row-selected {
    background-color: #1d2029;
}

.nexui-timeline-workarea {
    top: 0;
    height: 100%;
    background-color: rgba(109, 94, 252, 0.18);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: #6d5efc;
    border-right-color: #6d5efc;
}

.nexui-timeline-marker {
    position: absolute;
    top: 2px;
    width: 8px;
    height: 8px;
    background-color: #fbbf24;
    border-radius: 2px;
    rotate: 45deg;
}

/* AI Assistant ------------------------------------------------------------ */
.nexui-ai-root {
    flex-direction: column;
    background-color: #15171d;
    color: #e7eaf0;
}

.nexui-ai-header {
    padding: 14px 16px 10px 16px;
    border-bottom-width: 1px;
    border-bottom-color: #2b2f3a;
}

.nexui-ai-title {
    font-size: 18px;
    -unity-font-style: bold;
}

.nexui-ai-subtitle {
    margin-top: 3px;
    color: #9ca3b2;
    white-space: normal;
}

.nexui-ai-context {
    margin-top: 8px;
    color: #8a909b;
    font-size: 10px;
}

.nexui-ai-context.is-ready {
    color: #43e6c2;
}

.nexui-ai-settings {
    margin: 8px 12px 2px 12px;
    padding: 7px 9px 9px 9px;
    background-color: #1d2029;
    border-radius: 5px;
}

.nexui-ai-scope {
    margin: 4px 12px 2px 12px;
    padding: 7px 9px 9px 9px;
    background-color: #191d26;
    border-width: 1px;
    border-color: #303747;
    border-radius: 6px;
}

.nexui-ai-capabilities {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
    margin-bottom: 5px;
    padding: 5px;
    background-color: #151820;
    border-radius: 4px;
}

.nexui-ai-capabilities Toggle {
    width: 50%;
    min-width: 180px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.nexui-ai-chat-bar {
    flex-direction: row;
    align-items: center;
    margin: 8px 12px 4px 12px;
}

.nexui-ai-section-title {
    flex-grow: 1;
    -unity-font-style: bold;
    color: #dce1ea;
}

.nexui-ai-chat {
    flex-grow: 1;
    min-height: 180px;
    margin: 0 12px 6px 12px;
}

.nexui-ai-welcome {
    margin: 14px 8px;
    color: #9ca3b2;
    white-space: normal;
}

.nexui-ai-message {
    margin: 4px 2px;
    padding: 8px 10px;
    background-color: #20242e;
    border-radius: 6px;
    border-left-width: 2px;
    border-left-color: #596170;
}

.nexui-ai-message.is-user {
    background-color: #22263a;
    border-left-color: #6d5efc;
}

.nexui-ai-message.is-assistant {
    border-left-color: #43e6c2;
}

.nexui-ai-message.is-error {
    background-color: #332126;
    border-left-color: #ef6a78;
}

.nexui-ai-message-role {
    margin-bottom: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    color: #9ca3b2;
}

.nexui-ai-message-body,
.nexui-ai-action-row {
    white-space: normal;
}

.nexui-ai-plan-host {
    max-height: 240px;
    margin: 0 12px;
}

.nexui-ai-plan {
    padding: 9px 10px;
    background-color: #1d2029;
    border-width: 1px;
    border-color: #343948;
    border-radius: 6px;
}

.nexui-ai-plan-scope {
    margin-top: 3px;
    margin-bottom: 4px;
    color: #73cdbd;
    font-size: 9px;
    white-space: normal;
}

.nexui-ai-action-row {
    margin-top: 4px;
    color: #c8ced9;
}

.nexui-ai-plan-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

.nexui-ai-plan-buttons Button {
    margin-left: 6px;
}

.nexui-ai-composer {
    flex-direction: row;
    align-items: flex-end;
    margin: 8px 12px 0 12px;
}

.nexui-ai-prompt {
    flex-grow: 1;
    min-height: 58px;
    max-height: 130px;
    margin-right: 7px;
}

.nexui-ai-hint {
    margin: 4px 14px 9px 14px;
    color: #7f8795;
    font-size: 9px;
    white-space: normal;
}

/* Motion inspector ----------------------------------------------------------------------- */
.nexui-motion-inspector {
    padding-bottom: 8px;
}

.nexui-motion-overview {
    min-height: 58px;
    margin-bottom: 7px;
    padding: 8px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(139, 101, 255, 0.34);
    background-color: rgba(50, 39, 83, 0.64);
}

.nexui-motion-overview-icon {
    width: 36px;
    min-width: 36px;
    height: 36px;
    margin-right: 8px;
    border-radius: 8px;
    color: rgb(220, 207, 255);
    background-color: rgba(139, 101, 255, 0.24);
    font-size: 17px;
    -unity-text-align: middle-center;
}

.nexui-motion-overview-copy,
.nexui-motion-preview-copy {
    flex-grow: 1;
    min-width: 0;
}

.nexui-motion-overview-title,
.nexui-motion-preview-title,
.nexui-motion-section-title,
.nexui-motion-example-title {
    color: var(--nexui-text-primary);
    -unity-font-style: bold;
}

.nexui-motion-overview-title,
.nexui-motion-preview-title {
    font-size: 11px;
}

.nexui-motion-overview-subtitle {
    margin-top: 2px;
    color: var(--nexui-text-secondary);
    font-size: 9px;
    white-space: normal;
}

.nexui-motion-status-badge {
    min-width: 42px;
    height: 18px;
    margin-left: 6px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 9px;
    color: rgb(205, 194, 236);
    background-color: rgba(139, 101, 255, 0.18);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.nexui-motion-status-badge.is-ready {
    color: rgb(157, 238, 190);
    background-color: rgba(47, 151, 91, 0.22);
}

.nexui-motion-preview-card,
.nexui-motion-authoring-card,
.nexui-motion-examples {
    margin-bottom: 7px;
    padding: 8px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(255, 255, 255, 0.09);
    background-color: rgba(255, 255, 255, 0.025);
}

.nexui-motion-preview-card {
    border-color: rgba(73, 145, 255, 0.28);
    background-color: rgba(28, 44, 68, 0.56);
}

.nexui-motion-preview-header {
    margin-bottom: 7px;
    flex-direction: row;
    align-items: center;
}

.nexui-motion-preview-description,
.nexui-motion-section-description,
.nexui-motion-example-description,
.nexui-motion-empty-help,
.nexui-motion-binding-empty {
    color: var(--nexui-text-secondary);
    font-size: 9px;
    white-space: normal;
}

.nexui-motion-preview-description {
    margin-top: 2px;
}

.nexui-motion-replay {
    width: 28px;
    min-width: 28px;
    height: 28px;
    margin-left: 7px;
    padding: 0;
    border-radius: 14px;
    border-color: rgba(111, 177, 255, 0.44);
    color: rgb(205, 227, 255);
    background-color: rgba(73, 145, 255, 0.16);
    -unity-text-align: middle-center;
}

.nexui-motion-live-preview {
    height: 138px;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgba(120, 166, 225, 0.20);
    background-color: rgba(9, 14, 23, 0.68);
    overflow: hidden;
}

.nexui-motion-section-tabs {
    margin-bottom: 7px;
    padding: 3px;
    flex-direction: row;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgba(139, 101, 255, 0.22);
    background-color: rgba(20, 17, 31, 0.66);
}

.nexui-motion-section-tab {
    flex-grow: 1;
    min-height: 27px;
    margin: 1px;
    padding-left: 5px;
    padding-right: 5px;
    border-width: 0;
    border-radius: 5px;
    color: rgba(188, 190, 205, 0.90);
    background-color: transparent;
    font-size: 9px;
}

.nexui-motion-section-tab:hover {
    color: rgb(226, 219, 247);
    background-color: rgba(139, 101, 255, 0.10);
}

.nexui-motion-section-tab.is-selected {
    color: rgb(239, 234, 255);
    background-color: rgba(139, 101, 255, 0.24);
    -unity-font-style: bold;
}

.nexui-motion-section-page {
    flex-grow: 0;
}

.nexui-motion-example-stage,
.nexui-motion-example-path {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.nexui-motion-example-ghost,
.nexui-motion-example-target,
.nexui-motion-example-object {
    position: absolute;
    width: 48px;
    height: 36px;
    border-width: 1px;
    border-radius: 6px;
    -unity-text-align: middle-center;
}

.nexui-motion-example-ghost {
    border-color: rgba(90, 208, 181, 0.55);
    color: rgba(151, 234, 213, 0.72);
    background-color: rgba(46, 156, 128, 0.10);
    opacity: 0.48;
}

.nexui-motion-example-target {
    border-color: rgba(111, 177, 255, 0.45);
    background-color: rgba(73, 145, 255, 0.08);
}

.nexui-motion-example-object {
    border-color: rgba(159, 126, 255, 0.90);
    color: rgb(239, 234, 255);
    background-color: rgb(93, 70, 166);
    -unity-font-style: bold;
}

.nexui-motion-section-heading {
    margin-bottom: 7px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.07);
}

.nexui-motion-section-title {
    font-size: 11px;
}

.nexui-motion-section-description {
    margin-top: 2px;
}

.nexui-motion-action-row,
.nexui-motion-clip-row {
    flex-direction: row;
    align-items: center;
}

.nexui-motion-action-row {
    margin-top: 5px;
}

.nexui-motion-action-row > Button,
.nexui-motion-use-example {
    min-height: 26px;
}

.nexui-motion-action-primary {
    flex-grow: 1;
    border-color: rgba(139, 101, 255, 0.48);
    color: rgb(229, 220, 255);
    background-color: rgba(139, 101, 255, 0.17);
}

.nexui-motion-action-secondary {
    flex-grow: 1;
    margin-left: 4px;
}

.nexui-motion-empty-help,
.nexui-motion-binding-empty {
    margin-top: 5px;
    padding: 8px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 0.07);
    background-color: rgba(0, 0, 0, 0.13);
    -unity-text-align: middle-center;
}

.nexui-motion-variants {
    margin-top: 6px;
    padding: 5px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.10);
}

.nexui-motion-clip-row {
    margin-bottom: 4px;
}

.nexui-motion-clip-row > .unity-base-field {
    flex-grow: 1;
}

.nexui-motion-clip-preview {
    width: 28px;
    min-width: 28px;
    height: 24px;
    margin-left: 4px;
    padding: 0;
    border-radius: 5px;
}

.nexui-motion-example-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: -2px;
    margin-right: -2px;
}

.nexui-motion-example-card {
    width: 48%;
    min-height: 106px;
    margin: 2px;
    padding: 6px;
    align-items: stretch;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(0, 0, 0, 0.13);
}

.nexui-motion-example-card:hover {
    border-color: rgba(111, 177, 255, 0.52);
    background-color: rgba(73, 145, 255, 0.08);
}

.nexui-motion-example-card.is-selected {
    border-color: rgba(139, 101, 255, 0.78);
    background-color: rgba(139, 101, 255, 0.14);
}

.nexui-motion-example-thumbnail {
    height: 42px;
    margin-bottom: 4px;
    border-radius: 5px;
    background-color: rgba(20, 27, 39, 0.78);
}

.nexui-motion-example-title {
    font-size: 10px;
}

.nexui-motion-example-description {
    margin-top: 2px;
    font-size: 8px;
}

.nexui-motion-use-example {
    margin-top: 6px;
    border-color: rgba(139, 101, 255, 0.55);
    color: rgb(229, 220, 255);
    background-color: rgba(139, 101, 255, 0.17);
    -unity-font-style: bold;
}

.nexui-motion-binding {
    position: relative;
    margin: 4px 0 5px 0;
    padding: 7px 27px 7px 7px;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(0, 0, 0, 0.11);
}

.nexui-motion-binding-remove {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 20px;
    height: 20px;
    padding: 0;
    border-width: 0;
    border-radius: 10px;
    color: rgba(211, 218, 228, 0.78);
    background-color: rgba(255, 255, 255, 0.045);
}

.nexui-motion-binding-remove:hover {
    color: rgb(255, 195, 195);
    background-color: rgba(222, 70, 70, 0.25);
}

.nexui-motion-add-binding {
    min-height: 28px;
    margin-top: 5px;
    border-color: rgba(73, 145, 255, 0.42);
    color: rgb(211, 229, 255);
    background-color: rgba(73, 145, 255, 0.12);
    -unity-font-style: bold;
}

.nexui-component-property-heading {
    margin: 4px 4px 1px 4px;
    color: rgb(226, 232, 241);
    font-size: 12px;
    -unity-font-style: bold;
}

.nexui-component-property-description {
    margin: 0 4px 7px 4px;
    color: rgba(200, 211, 225, 0.72);
    font-size: 9px;
    white-space: normal;
}

.nexui-component-part-description {
    color: #9fb1ca;
    white-space: normal;
    margin-bottom: 8px;
}

.nexui-component-part-strip {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0 7px 0;
}

.nexui-component-part-chip {
    min-height: 24px;
    margin: 2px 4px 2px 0;
    padding: 2px 8px;
    border-radius: 12px;
    background-color: #202b3b;
    color: #b8c7db;
}

.nexui-component-part-chip.is-selected {
    background-color: #3277d5;
    color: white;
}

.nexui-component-part-card {
    margin: 4px 0 8px 0;
    padding: 8px;
    border-width: 1px;
    border-color: #33445d;
    border-radius: 5px;
    background-color: #151d29;
}

.nexui-component-part-card-title {
    -unity-font-style: bold;
    color: #e5eefb;
    margin-bottom: 3px;
}

.nexui-component-part-hint {
    color: #8294ad;
    white-space: normal;
    margin: 4px 0;
}

.nexui-component-part-reset {
    margin-top: 5px;
}

.nexui-component-content-row {
    height: 26px;
    -unity-text-align: middle-left;
    margin: 2px 0;
}

.nexui-component-content-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
}

.nexui-component-content-actions > Button {
    margin-right: 4px;
}

.nexui-inspector-advanced-toggle {
    margin: 5px 4px 3px 4px;
    padding: 4px 6px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.035);
}

.nexui-property-group {
    margin: 2px 2px 4px 2px;
    padding: 2px 4px 5px 4px;
    border-left-width: 2px;
    border-left-color: rgba(73, 145, 255, 0.34);
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.075);
}

.nexui-property-field {
    min-height: 20px;
    margin-top: 2px;
}

.nexui-property-field.is-overridden {
    border-left-width: 2px;
    border-left-color: rgba(89, 168, 255, 0.8);
}

.nexui-property-reset {
    width: 22px;
    height: 20px;
    margin-left: 3px;
    padding: 0;
    border-width: 0;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.055);
}

/* ---- Element component cards (Inspector) -------------------------------------
   Deliberately their own class names: .nexui-component-card belongs to the palette
   library, where cards are fixed 48% x 78px tiles. Reusing it here trapped every
   component's fields inside a 78px box and painted them over the sections below. */

/* Component cards sit in the same stack as the Inspector blocks, so they share its chrome:
   one continuous column of components, exactly like Unity's Inspector. */
.nexui-element-component-card {
    margin-bottom: 4px;
    padding: 2px 4px 5px 4px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    background-color: #1c1f25;
}

.nexui-element-component-card > .unity-foldout {
    margin-left: 0;
}

.nexui-element-component-card .unity-foldout__content {
    margin-left: 12px;
}

.nexui-element-component-menu {
    width: 22px;
    min-width: 22px;
    height: 18px;
    margin: 0 0 0 2px;
    padding: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.05);
    font-size: 12px;
}

.nexui-element-component-menu:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.nexui-element-component-add {
    height: 24px;
    margin: 6px 2px 2px 2px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(84, 151, 255, 0.45);
    background-color: rgba(84, 151, 255, 0.14);
    color: var(--nexui-text-primary);
}

.nexui-element-component-add:hover {
    background-color: rgba(84, 151, 255, 0.26);
}

.nexui-element-component-decompose {
    height: 18px;
    margin: 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 9px;
    font-size: 10px;
    background-color: rgba(255, 255, 255, 0.07);
}
